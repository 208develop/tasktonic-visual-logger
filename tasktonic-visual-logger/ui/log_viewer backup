import time
from PySide6.QtWidgets import QWidget, QToolTip, QMenu
from PySide6.QtCore import Qt, QRect, QTimer
from PySide6.QtGui import QPainter, QColor, QFont, QPen, QCursor

from ui.theme import Theme

from PySide6.QtWidgets import QVBoxLayout, QHBoxLayout, QScrollBar
import pprint


class LogViewer(QWidget):
    """Unified wrapper for ID Header, Virtual View, and Scrollbar."""

    def __init__(self, session_store, parent=None):
        super().__init__(parent)
        self.session_store = session_store

        self.header_widget = IDHeaderWidget(session_store, self)
        self.log_view = VirtualLogView(session_store, self)

        # De verdwenen scrollbar!
        self.scrollbar = QScrollBar(Qt.Vertical, self)
        self.scrollbar.valueChanged.connect(self._on_scrollbar_moved)

        # Zet de logs en de scrollbar naast elkaar
        h_layout = QHBoxLayout()
        h_layout.setContentsMargins(0, 0, 0, 0)
        h_layout.setSpacing(0)
        h_layout.addWidget(self.log_view)
        h_layout.addWidget(self.scrollbar)

        # Zet de header daar weer bovenop
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        layout.addWidget(self.header_widget)
        layout.addLayout(h_layout)

    def setup_on_start(self):
        self.log_view.setup_on_start()

    def maintain_scroll_position(self):
        self.log_view.maintain_scroll_position()

    def sync_scrollbar_to_view(self):
        total = len(self.log_view.logs)
        if total == 0:
            self.scrollbar.setRange(0, 0)
            return

        self.scrollbar.blockSignals(True)
        self.scrollbar.setRange(0, total - 1)
        # Scrollbar logic is inverted: 0 is top (oldest logs), max is bottom (newest logs)
        val = (total - 1) - self.log_view.scroll_index
        self.scrollbar.setValue(val)
        self.scrollbar.blockSignals(False)

    def _on_scrollbar_moved(self, value):
        total = len(self.log_view.logs)
        if total > 0:
            new_idx = (total - 1) - value
            self.log_view.scroll_index = new_idx
            self.session_store["ui/timeline/mode"] = "history"
            self.log_view._update_timeline_cursor_from_index()
            self.log_view.update()

# ==========================================
# Helpers for Lane and Color Calculations
# ==========================================

def get_dynamic_lanes(session_store):
    """Calculates the column (x-offset) for each ID based on seen_ids."""
    try:
        known_ids = session_store.get("ui/seen_ids", [])
        known_ids = sorted([int(x) for x in known_ids])
        return {tid: col for col, tid in enumerate(known_ids)}
    except (ValueError, TypeError, AttributeError):
        return {}


def get_contrast_color(bg_color):
    """Ensures white or black text is readable on the selected ID color."""
    lum = 0.299 * bg_color.red() + 0.587 * bg_color.green() + 0.114 * bg_color.blue()
    if lum > 130:
        return QColor("black")
    return QColor("white")


# ==========================================
# Interactive Header Widget
# ==========================================

class IDHeaderWidget(QWidget):
    def __init__(self, session_store, parent=None):
        super().__init__(parent)
        self.session_store = session_store
        self.setFixedHeight(30)

        self.setMouseTracking(True)
        self.setCursor(Qt.PointingHandCursor)

        # Geef de header een eigen hartslag zodat hij nieuwe ID's altijd tekent
        self._render_timer = QTimer(self)
        self._render_timer.timeout.connect(self.update)
        self._render_timer.start(500)  # Elke halve seconde checken is genoeg voor de header

    def paintEvent(self, event):
        painter = QPainter(self)
        try:
            painter.setRenderHint(QPainter.Antialiasing)
            painter.fillRect(self.rect(), QColor(Theme.BG_PANEL))

            lane_map = get_dynamic_lanes(self.session_store)

            for t_id, col_idx in lane_map.items():
                x = Theme.LANE_START_X + (col_idx * Theme.LANE_SPACING)
                is_active = self.session_store.get(f"ui/id/{t_id:02d}/active", True)
                color_idx = self.session_store.get(f"ui/id/{t_id:02d}/color_idx", 0) or 0

                target_color = Theme.get_color(color_idx)
                if not is_active:
                    target_color = QColor(getattr(Theme, 'LANE_INACTIVE', "#444444"))

                painter.setPen(Qt.NoPen)
                painter.setBrush(target_color)
                rect = QRect(x - 12, 5, 24, 20)
                painter.drawRoundedRect(rect, 6, 6)

                text_color = get_contrast_color(target_color) if is_active else QColor(Theme.TEXT_DIM)
                painter.setPen(text_color)
                painter.setFont(QFont("Consolas", 9, QFont.Bold))
                painter.drawText(rect, Qt.AlignCenter, f"{t_id:02d}")
        finally:
            painter.end()

    def mouseMoveEvent(self, event):
        lane_map = get_dynamic_lanes(self.session_store)
        for t_id, col_idx in lane_map.items():
            x = Theme.LANE_START_X + (col_idx * Theme.LANE_SPACING)
            rect = QRect(x - 12, 5, 24, 20)

            if rect.contains(event.position().toPoint()):
                name = self.session_store.get(f"ui/id/{t_id:02d}/name", f"ID {t_id}")
                t_type = self.session_store.get(f"ui/id/{t_id:02d}/type", "Unknown")
                QToolTip.showText(event.globalPosition().toPoint(), f"{t_type}: {name}", self)
                return

        QToolTip.hideText()

    def mousePressEvent(self, event):
        lane_map = get_dynamic_lanes(self.session_store)
        for t_id, col_idx in lane_map.items():
            x = Theme.LANE_START_X + (col_idx * Theme.LANE_SPACING)
            if abs(event.position().x() - x) < 15:
                self.show_context_menu(t_id, event.globalPosition().toPoint())
                break

    def show_context_menu(self, t_id, pos):
        menu = QMenu(self)
        style = f"background: {Theme.BG_BLOCK}; color: {Theme.TEXT_MAIN}; border: 1px solid {Theme.BG_PANEL};"
        menu.setStyleSheet(style)

        title_act = menu.addAction(f"Settings for ID {t_id:02d}")
        title_act.setEnabled(False)
        menu.addSeparator()

        is_active = self.session_store.get(f"ui/id/{t_id:02d}/active", True)
        toggle_text = "Hide Lane" if is_active else "Show Lane"
        toggle_act = menu.addAction(toggle_text)
        toggle_act.triggered.connect(lambda _, tid=t_id, active=not is_active: self.toggle_lane(tid, active))

        menu.addSeparator()

        for idx, (_, color_name) in enumerate(Theme.ID_COLORS):
            act = menu.addAction(color_name)
            act.triggered.connect(lambda _, tid=t_id, ci=idx: self.update_settings(tid, ci))

        menu.exec(pos)

    def toggle_lane(self, t_id, is_active):
        self.session_store.set([(f"ui/id/{t_id:02d}/active", is_active)])

    def update_settings(self, t_id, color_idx):
        self.session_store.set([(f"ui/id/{t_id:02d}/color_idx", color_idx)])


